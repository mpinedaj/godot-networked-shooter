<mxfile host="app.diagrams.net">
  <diagram id="02-decision-configuracion" name="02 Decisión de configuración"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="t" value="Configurar los routers · decisión rápida" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="800" height="30" as="geometry" /></mxCell>
    <mxCell id="st" value="Dos carriles según lo que aparezca al conectar la consola · fuente: docs/prueba-real.md" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="900" height="20" as="geometry" /></mxCell>
    <mxCell id="ini" value="" style="ellipse;html=1;fillColor=#1B1F24;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="288" width="24" height="24" as="geometry" /></mxCell>
    <mxCell id="b1" value="&lt;b&gt;Router en la mesa&lt;/b&gt;&lt;br&gt;encendido y cableado&lt;br&gt;consola al PC" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F7FB;strokeColor=#5B6B8C;strokeWidth=1.6;fontColor=#1B1F24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="266" width="200" height="68" as="geometry" /></mxCell>
    <mxCell id="q1" value="&lt;b&gt;¿Sale un prompt&lt;br&gt;por la consola?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5AD;strokeColor=#AAAA33;strokeWidth=1.6;fontColor=#1B1F24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="250" width="230" height="100" as="geometry" /></mxCell>
    <mxCell id="f1" value="&lt;b&gt;Revisar la consola&lt;/b&gt;&lt;br&gt;otro COM, driver del adaptador,&lt;br&gt;cable en CONSOLE (no AUX),&lt;br&gt;9600 8-N-1 sin flow control" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF1E3;strokeColor=#B45309;strokeWidth=1.6;fontColor=#1B1F24;fontSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="230" height="90" as="geometry" /></mxCell>
    <mxCell id="q2" value="&lt;b&gt;¿Responde a&lt;br&gt;comandos IOS?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5AD;strokeColor=#AAAA33;strokeWidth=1.6;fontColor=#1B1F24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="250" width="230" height="100" as="geometry" /></mxCell>
    <mxCell id="c1" value="&lt;b&gt;Carril 1 · Cisco IOS&lt;/b&gt;&lt;br&gt;interfaces + rutas estáticas,&lt;br&gt;sin NAT&lt;br&gt;&lt;br&gt;el cliente escribe&lt;br&gt;&lt;b&gt;192.168.1.10&lt;/b&gt; · UDP 9999" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F8F5C;strokeWidth=1.6;fontColor=#1B1F24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="160" width="300" height="140" as="geometry" /></mxCell>
    <mxCell id="c2" value="&lt;b&gt;Carril 2 · router con NAT&lt;/b&gt;&lt;br&gt;WAN estática en los dos routers +&lt;br&gt;redirección de puerto UDP 9999&lt;br&gt;en el router del servidor&lt;br&gt;&lt;br&gt;el cliente escribe&lt;br&gt;&lt;b&gt;10.0.0.1&lt;/b&gt; · UDP 9999" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F8F5C;strokeWidth=1.6;fontColor=#1B1F24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="300" height="150" as="geometry" /></mxCell>
    <mxCell id="e1" value="" style="html=1;endArrow=block;endSize=7;strokeWidth=1.8;strokeColor=#5B6B8C;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="104" y="300" as="sourcePoint" /><mxPoint x="130" y="300" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="e2" value="" style="html=1;endArrow=block;endSize=7;strokeWidth=1.8;strokeColor=#5B6B8C;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="300" as="sourcePoint" /><mxPoint x="380" y="300" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="e3" value="" style="html=1;endArrow=block;endSize=7;strokeWidth=1.8;strokeColor=#B45309;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="350" as="sourcePoint" /><mxPoint x="495" y="420" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="e4" value="" style="html=1;endArrow=block;endSize=7;strokeWidth=1.8;strokeColor=#3F8F5C;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="300" as="sourcePoint" /><mxPoint x="690" y="300" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="e5" value="" style="html=1;endArrow=block;endSize=7;strokeWidth=1.8;strokeColor=#3F8F5C;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="290" as="sourcePoint" /><mxPoint x="1000" y="230" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="e6" value="" style="html=1;endArrow=block;endSize=7;strokeWidth=1.8;strokeColor=#B45309;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="315" as="sourcePoint" /><mxPoint x="1000" y="405" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="l1" value="no" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#B45309;" vertex="1" parent="1"><mxGeometry x="505" y="370" width="50" height="20" as="geometry" /></mxCell>
    <mxCell id="l2" value="sí" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#3F8F5C;" vertex="1" parent="1"><mxGeometry x="630" y="272" width="40" height="20" as="geometry" /></mxCell>
    <mxCell id="l3" value="sí" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#3F8F5C;" vertex="1" parent="1"><mxGeometry x="940" y="240" width="40" height="20" as="geometry" /></mxCell>
    <mxCell id="l4" value="no" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#B45309;" vertex="1" parent="1"><mxGeometry x="940" y="360" width="40" height="20" as="geometry" /></mxCell>
    <mxCell id="n1" value="&lt;b&gt;Antes de escribir rutas&lt;/b&gt; el PC debe hacer ping al gateway de su router. Si eso falla, el problema es de cable o de IP del PC, no del enrutamiento." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF5AD;strokeColor=#AAAA33;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="520" height="90" as="geometry" /></mxCell>
    <mxCell id="n2" value="&lt;b&gt;Ojo con los switchports&lt;/b&gt;&lt;br&gt;Si show ip interface brief muestra FastEthernet0/1/0…0/3 como switchport y una Vlan1, la IP de la LAN se pone en interface Vlan1, no en el puerto físico." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF5AD;strokeColor=#AAAA33;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="620" y="550" width="640" height="100" as="geometry" /></mxCell>
  </root>
