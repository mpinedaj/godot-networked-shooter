    <mxCell id="n1" value="Cableado&lt;br&gt;PC ↔ switch y switch ↔ router: cable directo.&lt;br&gt;Router ↔ router: cable cruzado (enlace WAN).&lt;br&gt;SW-B reparte a PC2–PC5 por Fa0/1–Fa0/4, también directo." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF5AD;strokeColor=#AAAA33;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="70" y="510" width="560" height="110" as="geometry" /></mxCell>
    <mxCell id="n2" value="PC1 crea la partida y también juega (listen server).&lt;br&gt;PC2–PC5 se conectan como clientes a 192.168.1.10.&lt;br&gt;Montaje con equipos reales: docs/prueba-real.md." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF5AD;strokeColor=#AAAA33;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="650" y="510" width="360" height="110" as="geometry" /></mxCell>
