    <mxCell id="csl1" value="cable de consola (se mueve al Router B)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#B45309;" vertex="1" parent="1"><mxGeometry x="150" y="474" width="330" height="22" as="geometry" /></mxCell>
    <mxCell id="n1" value="&lt;b&gt;Cable de consola&lt;/b&gt;&lt;br&gt;PC → adaptador USB–RS232 (DB9) → cable rollover azul → puerto CONSOLE del router.&lt;br&gt;Se configura un router a la vez: primero A desde PC1, después B desde PC2." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF5AD;strokeColor=#AAAA33;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="620" height="100" as="geometry" /></mxCell>
    <mxCell id="n2" value="&lt;b&gt;Puertos&lt;/b&gt;&lt;br&gt;Cualquier puerto LAN del router sirve (suelen ser 4).&lt;br&gt;No hacen falta switches: el router reparte su propia LAN.&lt;br&gt;Si el enlace WAN falla, probar otro cable: los equipos&lt;br&gt;viejos no tienen auto-MDIX." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF5AD;strokeColor=#AAAA33;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="720" y="520" width="360" height="110" as="geometry" /></mxCell>
