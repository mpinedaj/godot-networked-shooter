  <diagram id="04-topologia-logica-sustentacion" name="04 Topología lógica en la mesa"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="660" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="t" value="Topología lógica · direccionamiento y rutas" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="800" height="30" as="geometry" /></mxCell>
    <mxCell id="st" value="Dos LAN /24 unidas por una WAN /30 · una ruta estática por router, sin NAT · el juego usa UDP 9999" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="900" height="20" as="geometry" /></mxCell>
    <mxCell id="zA" value="LAN A · 192.168.1.0/24" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#5B6B8C;align=left;verticalAlign=top;spacing=10;fontSize=12;fontStyle=1;fontColor=#5B6B8C;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="450" height="310" as="geometry" /></mxCell>
    <mxCell id="zB" value="LAN B · 192.168.2.0/24" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#5B6B8C;align=left;verticalAlign=top;spacing=10;fontSize=12;fontStyle=1;fontColor=#5B6B8C;" vertex="1" parent="1"><mxGeometry x="1030" y="60" width="430" height="540" as="geometry" /></mxCell>
    <mxCell id="w" value="WAN · 10.0.0.0/30" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="655" y="190" width="230" height="26" as="geometry" /></mxCell>
    <mxCell id="cam" value="Camino del paquete: UDP 9999&lt;br&gt;2 saltos de capa 3 · TTL −2" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#B45309;" vertex="1" parent="1"><mxGeometry x="615" y="225" width="300" height="40" as="geometry" /></mxCell>
    <mxCell id="p1" value="" style="html=1;endArrow=block;endSize=7;strokeWidth=2.4;strokeColor=#B45309;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180" y="330" as="sourcePoint" /><mxPoint x="1030" y="330" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="p2" value="" style="html=1;endArrow=block;endSize=7;strokeWidth=2.4;strokeColor=#B45309;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="330" as="sourcePoint" /><mxPoint x="640" y="330" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="p3" value="" style="html=1;endArrow=block;endSize=7;strokeWidth=2.4;strokeColor=#B45309;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="330" as="sourcePoint" /><mxPoint x="250" y="330" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="n1" value="&lt;b&gt;PC1 · servidor&lt;/b&gt;&lt;br&gt;192.168.1.10/24&lt;br&gt;gw 192.168.1.1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F7FB;strokeColor=#5B6B8C;strokeWidth=1.5;fontColor=#1B1F24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="180" height="80" as="geometry" /></mxCell>
    <mxCell id="n2" value="&lt;b&gt;Router A&lt;/b&gt;&lt;br&gt;LAN 192.168.1.1/24&lt;br&gt;WAN 10.0.0.1/30" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F7FB;strokeColor=#5B6B8C;strokeWidth=1.5;fontColor=#1B1F24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="290" width="160" height="80" as="geometry" /></mxCell>
    <mxCell id="n3" value="&lt;b&gt;Router B&lt;/b&gt;&lt;br&gt;WAN 10.0.0.2/30&lt;br&gt;LAN 192.168.2.1/24" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F7FB;strokeColor=#5B6B8C;strokeWidth=1.5;fontColor=#1B1F24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="290" width="140" height="80" as="geometry" /></mxCell>
    <mxCell id="n4" value="&lt;b&gt;PC2 · cliente&lt;/b&gt;&lt;br&gt;192.168.2.10/24&lt;br&gt;gw 192.168.2.1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F7FB;strokeColor=#5B6B8C;strokeWidth=1.5;fontColor=#1B1F24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="290" width="180" height="80" as="geometry" /></mxCell>
    <mxCell id="r1" value="Ruta estática&lt;br&gt;S 192.168.2.0/24&lt;br&gt;vía 10.0.0.2" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF5AD;strokeColor=#AAAA33;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="210" height="56" as="geometry" /></mxCell>
    <mxCell id="r2" value="Ruta estática&lt;br&gt;S 192.168.1.0/24&lt;br&gt;vía 10.0.0.1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF5AD;strokeColor=#AAAA33;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="860" y="400" width="210" height="56" as="geometry" /></mxCell>
    <mxCell id="nna" value="Sin NAT: cada LAN conserva su direccionamiento y los routers solo enrutan." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF5AD;strokeColor=#AAAA33;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="600" y="470" width="300" height="50" as="geometry" /></mxCell>
    <mxCell id="n1b" value="En «Unirse» se escribe 192.168.1.10 · puerto 9999 (UDP).&lt;br&gt;El host también juega: no hay servidor dedicado.&lt;br&gt;Hasta 8 jugadores; con 2 PC alcanza y sobra." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF5AD;strokeColor=#AAAA33;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="440" height="90" as="geometry" /></mxCell>
    <mxCell id="n2b" value="Si el router no acepta comandos y solo tiene página web, se usa el carril 2: NAT y redirección del puerto 9999. En ese caso el cliente escribe 10.0.0.1." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF5AD;strokeColor=#AAAA33;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="520" y="530" width="480" height="70" as="geometry" /></mxCell>
  </root>
